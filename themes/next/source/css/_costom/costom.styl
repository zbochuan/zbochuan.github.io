// 分类页面美化
.category-all-page {
  .category-all-title {
    text-align: center;
    font-size: 1.5em;
    margin: 20px 0;
    color: #555;
  }
  
  .category-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin: 20px 0;
  }
  
  .category-list-item {
    background: #f8f8f8;
    border-radius: 8px;
    padding: 15px;
    text-align: center;
    transition: all 0.3s ease;
    
    &:hover {
      background: #e8e8e8;
      transform: translateY(-2px);
    }
    
    a {
      text-decoration: none;
      color: #333;
      font-weight: 500;
    }
    
    .category-list-count {
      background: #42b983;
      color: white;
      border-radius: 12px;
      padding: 2px 8px;
      font-size: 0.8em;
      margin-left: 8px;
    }
  }
}

// 侧边栏分类样式优化
.sidebar-nav .sidebar-nav-toc .nav .nav-child {
  padding-left: 20px;
}